{
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/oauth-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-resource"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/auto-sync",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/push",
      "schedule": "0 0 * * *"
    }
  ]
}
