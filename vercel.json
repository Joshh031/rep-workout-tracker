{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/auto-sync",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/push",
      "schedule": "0 0 * * *"
    }
  ]
}
